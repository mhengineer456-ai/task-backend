# TaskPulse Pro Backend Environment Variables Example
# Copy this file to .env and fill in your actual credentials

PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Database Connection (Local or Cloud MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=taskpulse_db

# Railway native variables (automatically provided by Railway when using MySQL service)
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# n8n AI Automation Webhook URLs
N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/factory-ai-agents
N8N_TEST_WEBHOOK_URL=http://localhost:5678/webhook/factory-ai-agents

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
